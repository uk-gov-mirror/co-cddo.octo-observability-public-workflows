{
  "name": "@octo-observability/submit-sbom-action",
  "version": "1.0.0",
  "private": true,
  "description": "GitHub Action to submit repository SBOM to observability platform ingestion API",
  "main": "dist/index.js",
  "scripts": {
    "build": "ncc build src/main.ts -o dist --source-map --license licenses.txt",
    "lint": "eslint src/ --fix && prettier --write src/",
    "test": "jest",
    "all": "npm run lint && npm run test && npm run build",
    "prepare": "husky"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "dependencies": {
    "@actions/core": "3.0.1",
    "@actions/github": "9.1.1",
    "@actions/http-client": "4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/jest": "30.0.0",
    "@types/node": "26.5.1",
    "@vercel/ncc": "0.45.0",
    "eslint": "10.10.0",
    "husky": "9.1.7",
    "jest": "30.5.1",
    "lint-staged": "17.5.1",
    "prettier": "3.9.6",
    "ts-jest": "29.4.12",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "8.70.0"
  }
}
